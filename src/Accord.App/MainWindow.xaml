<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Accord.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Accord">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <!-- ==================== CUSTOM TITLE BAR ==================== -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Drag area -->
            <Grid x:Name="TitleBarDragArea" Grid.Column="0" Background="Transparent">
                <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Margin="16,0,0,0"
                    IsHitTestVisible="False">
                    <Image
                        x:Name="TitleBarIcon"
                        Width="20"
                        Height="20"
                        Stretch="Uniform" />
                    <TextBlock
                        x:Name="TitleBarTitle"
                        Text="Accord"
                        FontSize="14"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                    <Border
                        x:Name="VersionPill"
                        CornerRadius="4"
                        Padding="6,2"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="VersionPillText"
                            Text="v2.0"
                            FontSize="11"
                            FontWeight="Medium"
                            Typography.NumeralAlignment="Tabular" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Interactive title bar buttons (registered as Passthrough) -->
            <StackPanel
                x:Name="TitleBarControlsPanel"
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="6"
                Margin="0,0,144,0">

                <Button
                    x:Name="RefreshHeaderButton"
                    Click="RefreshButton_Click"
                    ClickMode="Release"
                    Height="32"
                    Padding="10,0"
                    CornerRadius="6"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Actualiser les périphériques (F5)">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>

                <Button
                    x:Name="ThemeToggleButton"
                    Click="ThemeToggleButton_Click"
                    ClickMode="Release"
                    Height="32"
                    Padding="10,0"
                    CornerRadius="6"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Basculer Clair / Sombre">
                    <FontIcon x:Name="ThemeToggleIcon" Glyph="&#xE708;" FontSize="14" />
                </Button>

                <Button
                    x:Name="OptionsHeaderButton"
                    Click="OptionsHeaderButton_Click"
                    ClickMode="Release"
                    Height="32"
                    Padding="12,0"
                    CornerRadius="6"
                    BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                        <TextBlock Text="Options" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== MAIN CONTENT ==================== -->
        <Grid Grid.Row="1" Margin="18,4,18,12" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Card: Bascule Automatique Live Banner -->
            <Border
                x:Name="SwitcherBannerCard"
                Grid.Row="0"
                CornerRadius="8"
                BorderThickness="1"
                Padding="16,12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Title + Watcher live state -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4" MinWidth="220">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                Text="Bascule automatique"
                                FontSize="14"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />
                            <Border
                                x:Name="WatcherStatePill"
                                CornerRadius="10"
                                Padding="8,2"
                                VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Ellipse x:Name="WatcherStateDot" Width="7" Height="7" VerticalAlignment="Center" />
                                    <TextBlock x:Name="WatcherStateText" Text="En pause" FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock
                            x:Name="DefaultOutputSubtitle"
                            Text="Sortie active : détection..."
                            FontSize="12"
                            TextTrimming="CharacterEllipsis"
                            MaxWidth="260" />
                    </StackPanel>

                    <!-- Center: 3 interactive profile pills -->
                    <Grid Grid.Column="1" VerticalAlignment="Center" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="PixelProfileButton"
                            Grid.Column="0"
                            Click="ProfileButton_Click"
                            ClickMode="Release"
                            Tag="Pixel"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="12,8"
                            CornerRadius="6"
                            BorderThickness="1">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7F6;" FontSize="15" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="Pixel Buds" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="PixelProfileSub" Text="Bluetooth" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Ellipse x:Name="PixelProfileDot" Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button
                            x:Name="RazerProfileButton"
                            Grid.Column="1"
                            Click="ProfileButton_Click"
                            ClickMode="Release"
                            Tag="Razer"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="12,8"
                            CornerRadius="6"
                            BorderThickness="1">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE95B;" FontSize="15" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="Razer" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="RazerProfileSub" Text="2,4 GHz HID" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Ellipse x:Name="RazerProfileDot" Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button
                            x:Name="ScreenProfileButton"
                            Grid.Column="2"
                            Click="ProfileButton_Click"
                            ClickMode="Release"
                            Tag="Screen"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="12,8"
                            CornerRadius="6"
                            BorderThickness="1">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7F4;" FontSize="15" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="Écran" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="ScreenProfileSub" Text="Sortie de repli" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Ellipse x:Name="ScreenProfileDot" Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- Right: Manual override reset + Auto-switch ToggleSwitch -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                        <Button
                            x:Name="ClearManualOverrideButton"
                            Click="ClearManualOverrideButton_Click"
                            ClickMode="Release"
                            Visibility="Collapsed"
                            Padding="10,5"
                            CornerRadius="6"
                            FontSize="12"
                            ToolTipService.ToolTip="Revenir au mode automatique">
                            <TextBlock Text="Auto" FontSize="12" FontWeight="SemiBold" />
                        </Button>
                        <ToggleSwitch
                            x:Name="BannerAutoSwitchToggle"
                            Toggled="AutoSwitchToggle_Toggled"
                            OnContent="Activée"
                            OffContent="Désactivée"
                            MinWidth="106"
                            Margin="0,0,-4,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main 2-column split: Device list + Selected device editor -->
            <Grid Grid.Row="1" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="348" />
                </Grid.ColumnDefinitions>

                <!-- Left Card: Audio Devices List -->
                <Border
                    x:Name="DeviceCatalogCard"
                    Grid.Column="0"
                    CornerRadius="8"
                    BorderThickness="1"
                    Padding="14,12">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Segmented Lecture / Enregistrement tabs + Search -->
                        <Grid Grid.Row="0" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                x:Name="FlowTabsContainer"
                                Grid.Column="0"
                                CornerRadius="6"
                                Padding="3"
                                BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button
                                        x:Name="PlaybackTabButton"
                                        Click="FlowTabButton_Click"
                                        ClickMode="Release"
                                        Tag="Render"
                                        Padding="12,6"
                                        CornerRadius="4"
                                        BorderThickness="0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE767;" FontSize="13" />
                                            <TextBlock Text="Lecture" FontSize="13" FontWeight="SemiBold" />
                                            <Border x:Name="PlaybackCountBadge" CornerRadius="8" Padding="6,1" MinWidth="24">
                                                <TextBlock
                                                    x:Name="PlaybackCountText"
                                                    Text="0"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    HorizontalAlignment="Center"
                                                    Typography.NumeralAlignment="Tabular" />
                                            </Border>
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="RecordingTabButton"
                                        Click="FlowTabButton_Click"
                                        ClickMode="Release"
                                        Tag="Capture"
                                        Padding="12,6"
                                        CornerRadius="4"
                                        BorderThickness="0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE720;" FontSize="13" />
                                            <TextBlock Text="Enregistrement" FontSize="13" FontWeight="SemiBold" />
                                            <Border x:Name="RecordingCountBadge" CornerRadius="8" Padding="6,1" MinWidth="24">
                                                <TextBlock
                                                    x:Name="RecordingCountText"
                                                    Text="0"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    HorizontalAlignment="Center"
                                                    Typography.NumeralAlignment="Tabular" />
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <TextBox
                                x:Name="SearchBox"
                                Grid.Column="1"
                                PlaceholderText="Filtrer par nom ou description..."
                                TextChanged="SearchBox_TextChanged"
                                VerticalAlignment="Center"
                                MaxWidth="260"
                                HorizontalAlignment="Right"
                                Width="230" />
                        </Grid>

                        <!-- Row 1: State filter pills -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <ToggleButton
                                    x:Name="FilterActiveButton"
                                    Click="FilterButton_Click"
                                    ClickMode="Release"
                                    IsChecked="True"
                                    CornerRadius="14"
                                    Padding="12,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse x:Name="FilterActiveDot" Width="7" Height="7" />
                                        <TextBlock Text="Actifs" FontSize="12" />
                                    </StackPanel>
                                </ToggleButton>

                                <ToggleButton
                                    x:Name="FilterDisconnectedButton"
                                    Click="FilterButton_Click"
                                    ClickMode="Release"
                                    IsChecked="False"
                                    CornerRadius="14"
                                    Padding="12,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse x:Name="FilterDisconnectedDot" Width="7" Height="7" />
                                        <TextBlock Text="Déconnectés" FontSize="12" />
                                    </StackPanel>
                                </ToggleButton>

                                <ToggleButton
                                    x:Name="FilterDisabledButton"
                                    Click="FilterButton_Click"
                                    ClickMode="Release"
                                    IsChecked="False"
                                    CornerRadius="14"
                                    Padding="12,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse x:Name="FilterDisabledDot" Width="7" Height="7" />
                                        <TextBlock Text="Désactivés" FontSize="12" />
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>

                            <TextBlock
                                x:Name="FilteredCountHint"
                                Grid.Column="1"
                                Text="0 affiché"
                                FontSize="12"
                                VerticalAlignment="Center"
                                MinWidth="78"
                                TextAlignment="Right"
                                Typography.NumeralAlignment="Tabular" />
                        </Grid>

                        <!-- Row 2: Scrollable device cards -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <StackPanel x:Name="DeviceListPanel" Spacing="6" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Right Card: Selected Device Inspector & Editor -->
                <Border
                    x:Name="InspectorCard"
                    Grid.Column="1"
                    CornerRadius="8"
                    BorderThickness="1"
                    Padding="16,14">
                    <Grid>
                        <!-- Empty state when nothing selected -->
                        <StackPanel
                            x:Name="InspectorEmptyState"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Visibility="Collapsed">
                            <FontIcon Glyph="&#xE7F5;" FontSize="28" Opacity="0.55" />
                            <TextBlock
                                Text="Sélectionnez un périphérique"
                                FontSize="14"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                x:Name="InspectorEmptyHint"
                                Text="Choisissez un appareil dans la liste pour le renommer, le sauvegarder ou le définir par défaut."
                                FontSize="12"
                                TextWrapping="Wrap"
                                TextAlignment="Center"
                                MaxWidth="250" />
                        </StackPanel>

                        <!-- Active editor content -->
                        <ScrollViewer x:Name="InspectorContentScroll" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="14">
                                <!-- Device header -->
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        x:Name="InspectorIconTile"
                                        Width="40"
                                        Height="40"
                                        CornerRadius="8"
                                        VerticalAlignment="Top">
                                        <FontIcon x:Name="InspectorDeviceIcon" Glyph="&#xE767;" FontSize="18" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock
                                            x:Name="InspectorHeaderTitle"
                                            Text="Périphérique"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border x:Name="InspectorFlowPill" CornerRadius="4" Padding="6,2">
                                                <TextBlock x:Name="InspectorFlowText" Text="Lecture" FontSize="11" FontWeight="Medium" />
                                            </Border>
                                            <Border x:Name="InspectorStatePill" CornerRadius="4" Padding="6,2">
                                                <TextBlock x:Name="InspectorStateText" Text="Actif" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Quick default button -->
                                <Button
                                    x:Name="SetDefaultButton"
                                    Click="SetDefaultButton_Click"
                                    ClickMode="Release"
                                    HorizontalAlignment="Stretch"
                                    Padding="12,8"
                                    CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE73E;" FontSize="13" />
                                        <TextBlock x:Name="SetDefaultButtonText" Text="Définir comme périphérique par défaut" FontSize="12.5" FontWeight="Medium" />
                                    </StackPanel>
                                </Button>

                                <!-- Editable fields -->
                                <StackPanel Spacing="10">
                                    <TextBox
                                        x:Name="NameTextBox"
                                        Header="Nom"
                                        PlaceholderText="Ex. Philips, Razer, Pixel..."
                                        TextChanged="EditorTextBox_TextChanged" />

                                    <TextBox
                                        x:Name="DescriptionTextBox"
                                        Header="Description (interface Windows)"
                                        PlaceholderText="Ex. Evnia 27M2N8500, BlackShark V3 Pro..."
                                        TextChanged="EditorTextBox_TextChanged" />

                                    <!-- Live Windows display preview -->
                                    <Border
                                        x:Name="PreviewBox"
                                        CornerRadius="6"
                                        BorderThickness="1"
                                        Padding="10,8">
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Name="PreviewCaption" Text="Aperçu dans Windows" FontSize="11" />
                                            <TextBlock
                                                x:Name="PreviewFullText"
                                                Text="Nom (Description)"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Primary Rename button -->
                                <Button
                                    x:Name="RenameButton"
                                    Click="RenameButton_Click"
                                    ClickMode="Release"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Padding="14,9"
                                    CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressRing
                                            x:Name="RenameProgressRing"
                                            Width="14"
                                            Height="14"
                                            IsActive="False"
                                            Visibility="Collapsed" />
                                        <FontIcon x:Name="RenameShieldIcon" Glyph="&#xEA18;" FontSize="14" />
                                        <TextBlock x:Name="RenameButtonText" Text="Renommer" FontSize="13" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>

                                <!-- Backup / Restore row -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        x:Name="BackupButton"
                                        Grid.Column="0"
                                        Click="BackupButton_Click"
                                        ClickMode="Release"
                                        HorizontalAlignment="Stretch"
                                        Padding="10,8"
                                        CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE74E;" FontSize="13" />
                                            <TextBlock Text="Sauvegarder" FontSize="12.5" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="RestoreButton"
                                        Grid.Column="1"
                                        Click="RestoreButton_Click"
                                        ClickMode="Release"
                                        HorizontalAlignment="Stretch"
                                        Padding="10,8"
                                        CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE777;" FontSize="13" />
                                            <TextBlock Text="Restaurer" FontSize="12.5" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Metadata card -->
                                <Border
                                    x:Name="DeviceMetaCard"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    Padding="10,8">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon x:Name="BackupStatusIcon" Glyph="&#xE73E;" FontSize="12" />
                                            <TextBlock x:Name="BackupStatusText" Text="Aucune sauvegarde" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                x:Name="DeviceGuidText"
                                                Grid.Column="0"
                                                Text="{}{00000000}"
                                                FontFamily="Consolas"
                                                FontSize="11"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />
                                            <Button
                                                x:Name="CopyGuidButton"
                                                Grid.Column="1"
                                                Click="CopyGuidButton_Click"
                                                ClickMode="Release"
                                                Padding="6,3"
                                                CornerRadius="4"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ToolTipService.ToolTip="Copier l'identifiant du périphérique">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== STATUS BAR ==================== -->
        <Grid x:Name="StatusBarGrid" Grid.Row="2" Padding="18,0,18,0" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" />
                <TextBlock
                    x:Name="StatusMessageText"
                    Text="Prêt."
                    FontSize="12"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                <Border
                    x:Name="AdminSessionBadge"
                    CornerRadius="4"
                    Padding="7,2"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xEA18;" FontSize="11" />
                        <TextBlock Text="Session admin active" FontSize="11" FontWeight="Medium" />
                    </StackPanel>
                </Border>

                <TextBlock
                    x:Name="TotalDevicesStatusText"
                    Text="0 appareils lus"
                    FontSize="12"
                    MinWidth="112"
                    TextAlignment="Right"
                    Typography.NumeralAlignment="Tabular"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ==================== OPTIONS SLIDE-IN DRAWER ==================== -->
        <Grid
            x:Name="OptionsOverlay"
            Grid.Row="1"
            Grid.RowSpan="2"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="448" />
            </Grid.ColumnDefinitions>

            <!-- Dimmed backdrop: click to dismiss -->
            <Border
                x:Name="OptionsBackdrop"
                Grid.Column="0"
                PointerReleased="OptionsBackdrop_PointerReleased" />

            <!-- Drawer panel -->
            <Border
                x:Name="OptionsDrawerPanel"
                Grid.Column="1"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Drawer header -->
                    <Grid Grid.Row="0" Padding="20,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                            <TextBlock Text="Options" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <Button
                            x:Name="CloseOptionsButton"
                            Grid.Column="1"
                            Click="CloseOptionsButton_Click"
                            ClickMode="Release"
                            Width="34"
                            Height="34"
                            Padding="0"
                            CornerRadius="6"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Fermer les options (Échap)">
                            <FontIcon Glyph="&#xE711;" FontSize="13" />
                        </Button>
                    </Grid>

                    <!-- Drawer body -->
                    <ScrollViewer Grid.Row="1" Padding="18,4,18,18" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14">

                            <!-- Section 1: Apparence & Stockage -->
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="OptSecAppearance" Text="Apparence et stockage" FontSize="12.5" FontWeight="SemiBold" Margin="2,0,0,0" />
                                <Border x:Name="OptAppearanceCard" CornerRadius="8" BorderThickness="1" Padding="14,12">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Thème de l'interface" FontSize="13" FontWeight="Medium" />
                                                <TextBlock x:Name="OptThemeDesc" Text="Mémorisé entre les lancements" FontSize="11.5" />
                                            </StackPanel>
                                            <ComboBox
                                                x:Name="ThemeComboBox"
                                                Grid.Column="1"
                                                Width="130"
                                                SelectionChanged="ThemeComboBox_SelectionChanged">
                                                <ComboBoxItem Content="Système" Tag="System" />
                                                <ComboBoxItem Content="Clair" Tag="Light" />
                                                <ComboBoxItem Content="Sombre" Tag="Dark" />
                                            </ComboBox>
                                        </Grid>

                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock x:Name="StorageModeTitle" Text="Mode de stockage" FontSize="13" FontWeight="Medium" />
                                                <TextBlock x:Name="StoragePathText" Text="..." FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button
                                                x:Name="OpenDataDirButton"
                                                Grid.Column="1"
                                                Click="OpenDataDirButton_Click"
                                                ClickMode="Release"
                                                Padding="10,6"
                                                CornerRadius="6"
                                                Content="Ouvrir" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Section 2: Bascule Automatique & Profils -->
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="OptSecSwitcher" Text="Bascule automatique du son" FontSize="12.5" FontWeight="SemiBold" Margin="2,0,0,0" />
                                <Border x:Name="OptSwitcherCard" CornerRadius="8" BorderThickness="1" Padding="14,12">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Surveillance en arrière-plan" FontSize="13" FontWeight="Medium" />
                                                <TextBlock x:Name="OptWatcherDesc" Text="Lance Accord.Watcher au démarrage de Windows" FontSize="11.5" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="OptionsAutoSwitchToggle"
                                                Grid.Column="1"
                                                Toggled="AutoSwitchToggle_Toggled"
                                                OnContent="Activée"
                                                OffContent="Désactivée"
                                                MinWidth="104" />
                                        </Grid>

                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Fréquence de vérification" FontSize="13" FontWeight="Medium" />
                                                <TextBlock x:Name="OptPollDesc" Text="Détection Bluetooth, dongle Razer HID et réparation" FontSize="11.5" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ComboBox
                                                x:Name="PollIntervalComboBox"
                                                Grid.Column="1"
                                                Width="96"
                                                SelectionChanged="PollIntervalComboBox_SelectionChanged">
                                                <ComboBoxItem Content="1 s" Tag="1" />
                                                <ComboBoxItem Content="2 s" Tag="2" />
                                                <ComboBoxItem Content="3 s" Tag="3" />
                                                <ComboBoxItem Content="5 s" Tag="5" />
                                            </ComboBox>
                                        </Grid>

                                        <Border x:Name="OptProfileDivider" Height="1" Margin="0,2" />

                                        <Expander
                                            x:Name="ProfileTargetsExpander"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            IsExpanded="False">
                                            <Expander.Header>
                                                <StackPanel Spacing="2" Margin="0,6">
                                                    <TextBlock Text="Cibles des profils (optionnel)" FontSize="13" FontWeight="Medium" />
                                                    <TextBlock x:Name="OptProfileSummaryDesc" Text="Par défaut : détection auto Pixel Buds, Razer HID et Philips Evnia" FontSize="11.5" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Expander.Header>
                                            <StackPanel Spacing="10">
                                                <ComboBox x:Name="PixelPlayCombo" Header="Pixel Buds — Sortie" HorizontalAlignment="Stretch" SelectionChanged="ProfileTargetCombo_SelectionChanged" />
                                                <ComboBox x:Name="PixelRecCombo" Header="Pixel Buds — Micro" HorizontalAlignment="Stretch" SelectionChanged="ProfileTargetCombo_SelectionChanged" />
                                                <ComboBox x:Name="RazerPlayCombo" Header="Razer — Sortie" HorizontalAlignment="Stretch" SelectionChanged="ProfileTargetCombo_SelectionChanged" />
                                                <ComboBox x:Name="RazerRecCombo" Header="Razer — Micro" HorizontalAlignment="Stretch" SelectionChanged="ProfileTargetCombo_SelectionChanged" />
                                                <ComboBox x:Name="ScreenPlayCombo" Header="Écran — Sortie de repli" HorizontalAlignment="Stretch" SelectionChanged="ProfileTargetCombo_SelectionChanged" />
                                                <Button
                                                    x:Name="ResetProfilesButton"
                                                    Click="ResetProfilesButton_Click"
                                                    ClickMode="Release"
                                                    HorizontalAlignment="Right"
                                                    Padding="10,5"
                                                    CornerRadius="6"
                                                    FontSize="12"
                                                    Content="Réinitialiser en détection auto" />
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Section 3: Restauration au démarrage -->
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="OptSecRestore" Text="Restauration des noms" FontSize="12.5" FontWeight="SemiBold" Margin="2,0,0,0" />
                                <Border x:Name="OptRestoreCard" CornerRadius="8" BorderThickness="1" Padding="14,12">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Restaurer au démarrage" FontSize="13" FontWeight="Medium" />
                                                <TextBlock x:Name="OptBootRestoreDesc" Text="Tâche planifiée AccordRestauration (privilèges élevés)" FontSize="11.5" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="BootRestoreToggle"
                                                Grid.Column="1"
                                                Toggled="BootRestoreToggle_Toggled"
                                                OnContent="Activée"
                                                OffContent="Désactivée"
                                                MinWidth="104" />
                                        </Grid>

                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                x:Name="BackupSummaryText"
                                                Text="0 appareil sauvegardé"
                                                FontSize="12"
                                                VerticalAlignment="Center"
                                                Typography.NumeralAlignment="Tabular" />
                                            <Button
                                                x:Name="RestoreAllNowButton"
                                                Grid.Column="1"
                                                Click="RestoreAllNowButton_Click"
                                                ClickMode="Release"
                                                Padding="12,6"
                                                CornerRadius="6">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xEA18;" FontSize="12" />
                                                    <TextBlock Text="Tout restaurer" FontSize="12.5" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Section 4: Journaux -->
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="OptSecLogs" Text="Journaux et diagnostic" FontSize="12.5" FontWeight="SemiBold" Margin="2,0,0,0" />
                                <Border x:Name="OptLogsCard" CornerRadius="8" BorderThickness="1" Padding="14,12">
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                Click="OpenLogsDirButton_Click"
                                                ClickMode="Release"
                                                Padding="10,6"
                                                CornerRadius="6"
                                                Content="Ouvrir les journaux" />
                                            <Button
                                                Click="RefreshLogsButton_Click"
                                                ClickMode="Release"
                                                Padding="10,6"
                                                CornerRadius="6"
                                                Content="Actualiser" />
                                        </StackPanel>
                                        <Border
                                            x:Name="LogsPreviewBox"
                                            CornerRadius="6"
                                            BorderThickness="1"
                                            Padding="10,8"
                                            MaxHeight="150">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <TextBlock
                                                    x:Name="LogsPreviewText"
                                                    Text="Aucune entrée récente."
                                                    FontFamily="Consolas"
                                                    FontSize="11"
                                                    TextWrapping="Wrap" />
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
